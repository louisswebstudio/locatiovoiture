{
  "version": 2,
  "builds": [{ "src": "*.html", "use": "@vercel/static" }],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/fleet", "dest": "/fleet.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" }
  ],
  "env": {
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key"
  }
}
